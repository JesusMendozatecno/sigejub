# ==============================================================
# SIGEJUB - Variables de Entorno (ejemplo)
# Copia este archivo a .env y ajusta los valores.
# ==============================================================

APP_NAME=SIGEJUB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Puerto donde corre el servidor (usado por inicio.php y scripts de arranque)
# APP_PORT=8000

# ==================== Base de Datos ==========================
# Variante: Linux + MySQL/MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigejub
DB_USERNAME=sigejub
DB_PASSWORD=

# (Opcional) Si existen, estas variables tienen prioridad sobre las
# equivalentes DB_* cuando la conexion es pgsql:
# DB_HOST_PGSQL=
# DB_PORT_PGSQL=
# DB_DATABASE_PGSQL=
# DB_USERNAME_PGSQL=
# DB_PASSWORD_PGSQL=

# Ruta del binario mysqldump para respaldos (vacio = PATH del sistema)
BACKUP_MYSQLDUMP_PATH=
# Ruta del binario pg_dump (solo si usas PostgreSQL)
BACKUP_PGDUMP_PATH=

SESSION_DRIVER=database
SESSION_COOKIE=sigejub_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sigejub@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==================== Tasas de Cambio API ====================
TASAS_API_ENABLED=true
TASAS_API_URL=https://ve.dolarapi.com/v1/dolares
TASAS_API_KEY=
TASAS_MONEDA_ORIGEN=USD
TASAS_MONEDA_DESTINO=VES
TASAS_CACHE_TTL=600
TASAS_INTERVALO_MINUTOS=60
